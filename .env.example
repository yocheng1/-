# SQLite 資料庫檔案位置（相對於專案根目錄）
# 註：登入 session 用的是隨機 token（資料庫只存 SHA-256），不是 JWT，
#     所以不需要額外設定簽章密鑰。
DATABASE_PATH=data/kplus.db

# ---- LINE Login (選填，沒設定時登入頁的 LINE 按鈕會停用) ----
# 於 https://developers.line.biz/console/ 建立 LINE Login channel 後取得
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/api/auth/line/callback

# ---- 簡訊 (OTP) ----
# console = 驗證碼直接印在伺服器 log（開發用）
# 之後要接真的簡訊商時，在 src/lib/auth/sms.ts 增加新的 provider
SMS_PROVIDER=console

# 開發模式下在 OTP 頁面直接顯示驗證碼，方便測試。正式環境務必設為 false
SHOW_OTP_IN_RESPONSE=true

# ---- 後台管理 ----
# 這些 email 登入後會自動成為管理員（逗號分隔）
ADMIN_EMAILS=admin@kplushelmet.com

# ---- 集點獎勵 ----
# 參加幾場活動可兌換一次
REWARD_THRESHOLD=3
# 限定兌換門市
REWARD_STORE=林口文化門市
# 門市工作人員的核銷密碼（請務必改掉）
STAFF_PIN=0000

# ---- Firebase ----
# 於 Firebase 主控台建立專案後填入
FIREBASE_PROJECT_ID=
# 服務帳戶金鑰的 JSON（整段貼進來，僅後端使用，切勿外流）
FIREBASE_SERVICE_ACCOUNT=
# 瀏覽器端設定（這些是公開的，可以放在前端）
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
